rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }

    // 管理者: admins/{自分のUID} がある人（Firebaseコンソールで最初に1回だけ作る）
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // 利用許可: 管理者、または allowed/{自分のメール} がある人（アプリの設定画面から管理者が追加）
    function isMember() {
      return isAdmin() || (verified() && exists(/databases/$(database)/documents/allowed/$(myEmail())));
    }

    function validPlaylist(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.videos is list && d.videos.size() <= 2000
        && d.get('viewerEmails', []) is list && d.get('viewerEmails', []).size() <= 20
        && d.get('editorEmails', []) is list && d.get('editorEmails', []).size() <= 20;
    }

    // 管理者用: 管理者の登録（コンソールからのみ）。本人は自分の分だけ読める
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // 許可リスト: 管理者だけが追加・削除。本人は自分のメールの分だけ読める
    match /allowed/{email} {
      allow read: if isAdmin() || (verified() && myEmail() == email);
      allow write: if isAdmin();
    }

    // プレイリスト: 持ち主は全操作。共有された相手は「見るだけ」または「動画の編集」まで。
    match /users/{userId}/playlists/{playlistId} {
      allow read: if signedIn() && isMember() && (
        request.auth.uid == userId
        || (verified() && (myEmail() in resource.data.get('viewerEmails', [])
                           || myEmail() in resource.data.get('editorEmails', []))));

      allow create: if signedIn() && isMember() && request.auth.uid == userId && validPlaylist(request.resource.data);

      allow update: if signedIn() && isMember() && (
        (request.auth.uid == userId && validPlaylist(request.resource.data))
        || (verified() && myEmail() in resource.data.get('editorEmails', [])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['videos', 'updatedAt'])
            && request.resource.data.videos is list && request.resource.data.videos.size() <= 2000));

      allow delete: if signedIn() && isMember() && request.auth.uid == userId;
    }

    // 「共有されたプレイリスト」一覧用の目印（宛先メールアドレスの本人だけが読める）
    match /shares/{email}/items/{playlistId} {
      allow read: if isMember() && verified() && myEmail() == email;
      allow delete: if signedIn() && isMember() && (
        resource.data.ownerUid == request.auth.uid || (verified() && myEmail() == email));
      allow create, update: if signedIn() && isMember()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerEmail', 'playlistId', 'role', 'name'])
        && request.resource.data.playlistId == playlistId
        && request.resource.data.role in ['view', 'edit']
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/playlists/$(playlistId));
    }

    // それ以外はすべて拒否
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
